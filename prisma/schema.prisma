generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  role         String       @default("user")
  avatar       String?
  bio          String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  accounts     Account[]
  articles     Article[]
  comments     Comment[]
  sessions     Session[]
  toolRatings  ToolRating[]
}

model ToolRating {
  id        String   @id @default(cuid())
  toolId    String
  toolName  String
  userId    String
  rating    Int
  review    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([toolId, userId])
  @@index([toolId, createdAt])
  @@index([userId])
}

model Article {
  id         String    @id @default(cuid())
  title      String
  slug       String    @unique
  content    String
  excerpt    String?
  coverImage String?
  youtubeUrl String?
  published  Boolean   @default(false)
  authorId   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments   Comment[]

  @@index([authorId])
  @@index([published, createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  articleId String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
  @@index([authorId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String
  icon        String
  featured    Boolean     @default(false)
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  comparison  Comparison?

  @@index([featured, order])
}

model Comparison {
  id          String   @id @default(cuid())
  categoryId  String   @unique
  title       String
  description String
  data        String
  lastUpdated DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model ContactSubmission {
  id          String   @id @default(cuid())
  fullName    String
  email       String
  mobile      String?
  description String
  status      String   @default("new")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
}

model ContactRecipient {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Domain {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String
  icon        String
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  subdomains  Subdomain[]

  @@index([order])
}

model Subdomain {
  id          String             @id @default(cuid())
  domainId    String
  name        String
  slug        String
  description String
  icon        String             @default("brain")
  order       Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  comparisons DomainComparison[]
  domain      Domain             @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, slug])
  @@index([domainId, order])
}

model DomainComparison {
  id          String    @id @default(cuid())
  subdomainId String
  title       String
  slug        String
  description String
  data        String
  lastUpdated DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  subdomain   Subdomain @relation(fields: [subdomainId], references: [id], onDelete: Cascade)

  @@unique([subdomainId, slug])
  @@index([subdomainId])
}

model AIProvider {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  tier        Int       @default(1)
  description String?
  website     String?
  logoUrl     String?
  apiKeyEnv      String?
  encryptedApiKey String?
  apiFormat   String    @default("openai")
  apiBaseUrl  String?
  isActive    Boolean   @default(true)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  models      AIModel[]

  @@index([tier, isActive, order])
}

model AIModel {
  id            String     @id @default(cuid())
  providerId    String
  name          String
  slug          String     @unique
  modelId       String
  description   String?
  initial       String     @default("?")
  colorClass    String     @default("bg-zinc-500/10 text-zinc-700 dark:text-zinc-400")
  borderClass   String     @default("border-zinc-500/20")
  gradientClass String     @default("from-zinc-500/10 to-zinc-500/5")
  inputPricePer1M  Float   @default(0)
  outputPricePer1M Float   @default(0)
  isActive      Boolean    @default(true)
  order         Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  provider      AIProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, isActive, order])
  logs ApiRequestLog[]
}

model ApiRequestLog {
  id               String    @id @default(cuid())
  userId           String?
  feature          String    // "compare" | "prompt-battle"
  promptTruncated  String    // up to 3000 chars
  promptTokens     Int       @default(0)
  completionTokens Int       @default(0)
  totalTokens      Int       @default(0)
  costUsd          Float     @default(0)
  providerName     String    // denormalized — survives model/provider edits
  modelName        String
  modelSlug        String
  modelDbId        String?
  latencyMs        Int?
  status           String    // "ok" | "error" | "timeout" | "no_key"
  errorMessage     String?
  createdAt        DateTime  @default(now())

  model            AIModel?  @relation(fields: [modelDbId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([feature, createdAt])
  @@index([modelSlug, createdAt])
  @@index([createdAt])
}
